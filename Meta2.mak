BRCC32 = brcc32
!endif
# ---------------------------------------------------------------------------
PATHCPP = .;"E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Get Version";"E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\NVRAM Editor";E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\AttestationKey;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Baseband;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\BT;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Comm\UART;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Console;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\DRMKey;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\factory;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\FM;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\AttestationKey;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\BT;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\DRMKey;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\FM;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\GPS;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\MultiSIM;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\RatConfig;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Form\WiFi;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\General;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\GPS;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\GSensor;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\GYROSensor;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\HDCP;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\HwTest;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Man;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\MF_Setup;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Misc;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\MSIM;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\NFC;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\RatConfig;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Security;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\SpecialTest;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\WiFi
