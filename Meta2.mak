PATHASM = .
PATHOBJ = .;E:\4N_release\W1904_Tool\SP_META_TOOL_V2_2\Output;$(LIBPATH)
PATHIDL = .
# ---------------------------------------------------------------------------
!if $d(PATHCPP)
.path.cpp = $(PATHCPP)
.path.c   = $(PATHCPP)
!endif

!if $d(PATHPAS)
.path.pas = $(PATHPAS)
!endif

!if $d(PATHASM)
.path.asm = $(PATHASM)
!endif

!if $d(PATHRC)
.path.rc  = $(PATHRC)
!endif

!if $d(PATHOBJ)
.path.obj  = $(PATHOBJ)
!endif

!if $d(PATHIDL)
.path.idl  = $(PATHIDL)
!endif
# ---------------------------------------------------------------------------
.suffixes: .cpp .cc .cxx .c .pas .asm .rc .idl
# ---------------------------------------------------------------------------
all: directories $(PROJECT)

$(PROJECT): $(OTHERFILES) $(IDLGENFILES) $(OBJFILES) $(RESDEPEN) $(DEFFILE) $(LIBFILES)
	$(LINKER) @&&|
	$(LFLAGS) +
	$(ALLOBJ), +
	$(PROJECT),, +
	$(ALLLIB), +
	$(DEFFILE), +
	$(ALLRES)
|
# ---------------------------------------------------------------------------
Default-Build:
	$(MAKE) -DCONFIGURATION=Default-Build -f Meta2.mak

directories:
	-@mkdir "$(OBJOUTDIR)" 2>NUL >NUL
	-@mkdir $(PROJECTOUTDIR) 2>NUL >NUL

clean:
	-@del $(OBJFILES)
targetclean:
	-@del $(PROJECT:.exe=.tds)
	-@del $(PROJECT:.exe=.il?)
	-@del $(PROJECT:.exe=.map)
	-@del $(PROJECT)

distclean: clean targetclean

# ---------------------------------------------------------------------------
.pas.hpp:
	@for %i in (${< }) do @echo %i:
	$(BCB)\BIN\$(DCC32) $(PFLAGS) --BCB {$< }

.pas.obj:
	@for %i in (${< }) do @echo %i:
	$(BCB)\BIN\$(DCC32) $(PFLAGS) --BCB {$< }

.cpp.obj:
	$(BCB)\BIN\$(BCC32) $(CFLAGS) -n$(@D) {$< }

.c.obj:
	$(BCB)\BIN\$(BCC32) $(CFLAGS) -n$(@D) {$< }

.c.i:
	$(BCB)\BIN\$(CPP32) $(CFLAGS) -n. {$< }

.cpp.i:
	$(BCB)\BIN\$(CPP32) $(CFLAGS) -n. {$< }

.asm.obj:
	$(BCB)\BIN\$(TASM32) $(AFLAGS) $<, $@

.rc.res:
	$(BCB)\BIN\$(BRCC32) $(RFLAGS) -fo$@ $<

.idl.cpp:
	$(BCB)\BIN\$(IDL2CPP) $(IDLCFLAGS) $<
